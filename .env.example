# Supabase Postgres — used by drizzle-orm.
# DATABASE_URL: the pooled connection string (Supavisor, transaction mode) —
#   used by the running app. Project Settings -> Database -> Connection string -> Pooler.
# DIRECT_URL: the direct connection string — used only for running migrations
#   (drizzle-kit), since the transaction-mode pooler doesn't support the
#   session-level features DDL needs. Same page -> Direct connection.
DATABASE_URL="postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Supabase Storage — stores uploaded PDFs and generated Excel BOMs.
# SUPABASE_SERVICE_ROLE_KEY is a backend-only secret (bypasses Row Level
# Security) — never expose it to the client. Project Settings -> API.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""

# Optional: enables AI enrichment of ambiguous line items.
# Free tier, no credit card: https://aistudio.google.com/apikey
# If unset, enrichment is silently skipped and everything else still works.
GEMINI_API_KEY=""

PORT=3000
NODE_ENV=development
