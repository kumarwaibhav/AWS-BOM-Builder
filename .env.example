# Database (MySQL/TiDB) — used by drizzle-orm
DATABASE_URL="mysql://user:password@host:3306/aws_bom"

# Cloudflare R2 — stores uploaded PDFs and generated Excel BOMs.
# R2 speaks the S3 API, so this uses the AWS S3 SDK under the hood, just
# pointed at R2 instead. Free tier: 10GB storage, no egress fees, no time
# limit. Create a bucket + API token at dash.cloudflare.com → R2.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Optional: enables AI enrichment of ambiguous line items.
# Free tier, no credit card: https://aistudio.google.com/apikey
# If unset, enrichment is silently skipped and everything else still works.
GEMINI_API_KEY=""

PORT=3000
NODE_ENV=development
